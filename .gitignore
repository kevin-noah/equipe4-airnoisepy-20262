# Environnement virtuel local.
# Il ne doit pas être envoyé sur GitHub.
.venv/

# Fichiers temporaires générés automatiquement par Python.
__pycache__/
*.pyc

# Cache généré par pytest.
.pytest_cache/

# Fichiers locaux générés par PyCharm.
.idea/

# Métadonnées et artefacts de packaging générés automatiquement
# (build/ est créé par « pip install . » / la construction du wheel).
*.egg-info/
build/
dist/

# Déchets macOS (Finder).
.DS_Store

# Fichier local pouvant contenir des mots de passe ou clés API.
.env

# Dossier de résultats générés automatiquement.
results/

# Fichiers intermédiaires de Sphinx (le HTML final, lui, est versionné
# car il fait partie du livrable de remise).
docs/_build/doctrees/